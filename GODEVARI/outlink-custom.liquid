{% comment %}
  外部链接自定义按钮 - 用于替换"加入购物车"按钮，重定向到联盟链接
  
  参数:
  - product: 产品对象
  - o_showOutlink: 是否显示外部链接按钮（1表示显示）
  - o_hideCart: 是否隐藏原始的加入购物车按钮（1表示隐藏）
  - o_classes: 按钮的CSS类名
  - o_style: 按钮的内联样式
  - o_button_style: 按钮样式类型 ('main-product' 默认, 'product-form' 用于产品表单)
{% endcomment %}

{% assign affiliate_link = product.metafields.custom.affiliate_link %}
{% assign button_style = o_button_style | default: 'main-product' %}

{% if affiliate_link != blank and o_showOutlink == 1 %}
  {%- comment -%} 从URL中提取网站名称 {%- endcomment -%}
  {% assign domain = affiliate_link | remove: 'https://' | remove: 'http://' | remove: 'www.' | split: '/' | first | split: '.' %}
  {% assign website_name = domain[0] | capitalize %}
  {% assign button_text = 'View on ' | append: website_name %}
  
  {% if button_style == 'product-form' %}
    {%- comment -%} 适配 product-form.liquid 的按钮样式 {%- endcomment -%}
    <a
      href="{{ affiliate_link }}"
      target="_blank"
      rel="noopener noreferrer"
      class="add_to_cart global-button {% if o_classes != blank %}{{ o_classes }}{% endif %} affiliate-link-button"
      style="width: 100% !important; display: flex !important; align-items: center !important; justify-content: center !important; text-decoration: none !important; box-sizing: border-box !important; {% if o_style != blank %}{{ o_style }}{% endif %}"
    >
      <span class="text">
        {{ button_text }}
      </span>
      <svg width="14" height="14" fill="none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14 14" class="external-link-icon">
        <path d="M11.0833 11.0833H2.91667V2.91667H7V1.75H2.91667C2.27083 1.75 1.75 2.27083 1.75 2.91667V11.0833C1.75 11.7292 2.27083 12.25 2.91667 12.25H11.0833C11.7292 12.25 12.25 11.7292 12.25 11.0833V7H11.0833V11.0833ZM8.16667 1.75V2.91667H10.2608L4.94667 8.23083L5.76917 9.05333L11.0833 3.73917V5.83333H12.25V1.75H8.16667Z" fill="currentColor"/>
      </svg>
    </a>
    
    <style>
      .o_original_{{ product.id }} {
        display: none !important;
      }
      
      .affiliate-link-button,
      a.affiliate-link-button,
      .global-button.affiliate-link-button {
        width: 100% !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        text-decoration: none !important;
        box-sizing: border-box !important;
        min-width: 100% !important;
        max-width: 100% !important;
      }
      .affiliate-link-button .text {
        margin-right: 8px;
      }
      .affiliate-link-button .external-link-icon {
        margin-left: 8px;
        flex-shrink: 0;
      }
      .affiliate-link-button:hover {
        opacity: 0.9;
      }
    </style>
    
  {% else %}
    {%- comment -%} 原有的 main-product-blocks.liquid 样式 {%- endcomment -%}
    <a
      href="{{ affiliate_link }}"
      target="_blank"
      rel="noopener noreferrer"
      class="m-add-to-cart m-spinner-button m-button m-button--primary m-affiliate-link-button {% if o_classes != blank %}{{ o_classes }}{% endif %}"
      style="width: 100% !important; display: flex !important; align-items: center !important; justify-content: center !important; box-sizing: border-box !important; {% if o_style != blank %}{{ o_style }}{% endif %}"
    >
      <span class="m-spinner-icon" style="display: none;">
        <svg class="animate-spin m-svg-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      </span>
      <span class="m-add-to-cart--text m-affiliate-link-text">
        {{ button_text }}
      </span>
      <span class="m-affiliate-link-icon">
        <svg width="14" height="14" fill="none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14 14">
          <path d="M11.0833 11.0833H2.91667V2.91667H7V1.75H2.91667C2.27083 1.75 1.75 2.27083 1.75 2.91667V11.0833C1.75 11.7292 2.27083 12.25 2.91667 12.25H11.0833C11.7292 12.25 12.25 11.7292 12.25 11.0833V7H11.0833V11.0833ZM8.16667 1.75V2.91667H10.2608L4.94667 8.23083L5.76917 9.05333L11.0833 3.73917V5.83333H12.25V1.75H8.16667Z" fill="currentColor"/>
        </svg>
      </span>
    </a>
    
    <style>
      .o_original_{{ product.id }} {
        display: none !important;
      }
      
      .m-affiliate-link-button,
      a.m-affiliate-link-button,
      .m-button.m-affiliate-link-button {
        width: 100% !important;
        padding: 10px 18px;
        text-align: center;
        font-weight: 600;
        transition: background-color 0.2s ease;
        cursor: pointer;
        border-radius: 0;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        box-sizing: border-box !important;
        min-width: 100% !important;
        max-width: 100% !important;
      }
      
      .m-affiliate-link-button:hover {
        opacity: 0.9;
      }
      
      .m-affiliate-link-icon {
        margin-left: 8px;
        display: inline-flex;
      }
      
      .m-affiliate-link-text {
        display: inline-flex;
      }
    </style>
  {% endif %}

{% endif %} 